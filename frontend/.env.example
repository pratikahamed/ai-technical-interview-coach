# FastAPI Backend URL (without trailing slash)
# Local development: http://localhost:8000
# Production: https://<your-render-backend-service>.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical Site URL (for SEO and OpenGraph metadata)
# Local development: http://localhost:3000
# Production: https://<your-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECURITY NOTICE:
# Never store backend secrets (such as GROQ_API_KEY) in frontend .env files or client-side bundles.
# All question generation and server-side rubric scoring occur strictly within the backend.
